    document.addEventListener("DOMContentLoaded", function() {
        // 判断当前是后端Jinja2实际解析过的最终HTML，还是未处理的原生模板前端预览
        const isJinjaProcessed = !document.body.innerHTML.includes('{{');
        
        if (!isJinjaProcessed) {
            // 前端预览模式下：取消隐藏仿真面板
            document.getElementById('preview-control-panel').classList.remove('hidden');
            
            // 初始化GIS视口 cursor-tracker 经纬度及植被指数提取
            initGisCursorTracker();
            
            // scenario 切换事件监听
            const selector = document.getElementById('scenario-selector');
            selector.addEventListener('change', function(e) {
                renderScenario(e.target.value);
            });
            
            // 默认渲染第一个场景：小麦冬前斑秃识别
            renderScenario('baldness_detection');
        } else {
            // 在后端环境下，直接初始化静态解译GIS视口的鼠标联动机制即可
            initGisCursorTracker();
        }
    });

    function initGisCursorTracker() {
        const viewport = document.getElementById('gis-viewport');
        if (!viewport) return;
        
        viewport.addEventListener('mousemove', function(e) {
            const rect = viewport.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            
            // 经典地理测绘经纬度及坐标变换
            const pctX = (x / rect.width).toFixed(4);
            const pctY = (y / rect.height).toFixed(4);
            
            // 设定该示范区空间起算点
            const lat = (34.0294 + (1 - pctY) * 0.05).toFixed(4);
            const lon = (113.4829 + pctX * 0.05).toFixed(4);
            
            // 动态仿真NDVI指数（健康度）
            const ndvi = (0.15 + (Math.sin(pctX * 6.5) * Math.cos(pctY * 6.5) + 1.25) * 0.35).toFixed(2);
            
            const readout = document.getElementById('gis-coords');
            if (readout) {
                readout.innerHTML = `COORDS: ${lat}° N, ${lon}° E | 光栅实点 NDVI: <span class="text-emerald-950 font-bold font-mono">${ndvi}</span> | SCALE 1:50,000`;
            }
        });
    }

    function renderScenario(scenKey) {
        const data = scenarios[scenKey];
        if (!data) return;

        // 1. 基本标题、编号、日期、气象背景替换
        document.getElementById('lbl-title').innerText = data.title;
        document.getElementById('lbl-request-id').innerText = data.request_id;
        document.getElementById('lbl-generated-at').innerText = new Date().toISOString().replace('T', ' ').substring(0, 19);
        
        // 气象背景替换
        document.getElementById('lbl-sensor-opt').innerText = data.sensors.opt;
        document.getElementById('lbl-sensor-sar').innerText = data.sensors.sar;
        document.getElementById('lbl-weather-gdd').innerText = data.sensors.gdd;
        document.getElementById('lbl-soil-moisture').innerText = data.sensors.sm;

        // 2. 徽章渲染
        const badgeHTML = getTaskBadgeHTML(data.task_type);
        document.getElementById('lbl-task-badge').innerHTML = badgeHTML;
        document.getElementById('lbl-region-badge').innerText = `监测省区: ${data.region.toUpperCase()}`;
        document.getElementById('lbl-crop-badge').innerText = `作物类型: ${getCropZH(data.crop_type)}`;

        // 3. 用户意图及大田学术概述
        document.getElementById('lbl-user-query').innerText = data.user_query;
        document.getElementById('lbl-overview').innerText = data.overview;

        // 4. 双向优势VS限制段落替换 (体现辩证多方面考虑)
        document.getElementById('lbl-positive-text').innerText = data.positive_text;
        document.getElementById('lbl-negative-text').innerText = data.negative_text;

        // 5. 关键结论发现替换
        let findingsHTML = '<ul class="space-y-3">';
        data.findings.forEach((finding, idx) => {
            findingsHTML += `
                <li class="flex items-start gap-3">
                    <span class="flex-shrink-0 w-5 h-5 rounded bg-emerald-50 text-emerald-900 flex items-center justify-center text-[10px] font-bold border border-emerald-100 no-print">
                        ${idx + 1}
                    </span>
                    <span class="text-xs text-slate-600 leading-relaxed print-text">${finding}</span>
                </li>
            `;
        });
        findingsHTML += '</ul>';
        document.getElementById('container-key-findings').innerHTML = findingsHTML;

        // 6. 算法模型及版本更新
        document.getElementById('lbl-model-name').innerText = data.model_name;
        document.getElementById('lbl-model-name-short').innerText = data.model_name;
        document.getElementById('lbl-model-version').innerText = data.model_version;

        // 7. 测算指标卡片数据更新 (Affected Area, Coverage Ratio, Loss Rate, Polygons)
        renderKpiCards(data);

        // 8. SVG 地理地图分类多边形模拟
        const poly1 = document.getElementById('gis-poly-1');
        const poly2 = document.getElementById('gis-poly-2');
        const poly3 = document.getElementById('gis-poly-3');
        if (poly1 && poly2 && poly3) {
            if (data.task_type === 'baldness_detection') {
                poly1.setAttribute('fill', '#e2efe5'); poly1.setAttribute('stroke', '#9bbda5');
                poly2.setAttribute('fill', '#f8ece4'); poly2.setAttribute('stroke', '#d5b099');
                poly3.setAttribute('fill', '#fcf9ec'); poly3.setAttribute('stroke', '#d4cb9f');
            } else if (data.task_type === 'lai_inversion') {
                poly1.setAttribute('fill', '#e0f2fe'); poly1.setAttribute('stroke', '#7dd3fc');
                poly2.setAttribute('fill', '#e2efe5'); poly2.setAttribute('stroke', '#9bbda5');
                poly3.setAttribute('fill', '#fafaf9'); poly3.setAttribute('stroke', '#e7e5e4');
            } else if (data.task_type === 'crop_health_detection') {
                poly1.setAttribute('fill', '#e2efe5'); poly1.setAttribute('stroke', '#9bbda5');
                poly2.setAttribute('fill', '#fee2e2'); poly2.setAttribute('stroke', '#fca5a5');
                poly3.setAttribute('fill', '#fef3c7'); poly3.setAttribute('stroke', '#fcd34d');
            } else {
                poly1.setAttribute('fill', '#e2efe5'); poly1.setAttribute('stroke', '#9bbda5');
                poly2.setAttribute('fill', '#f5f5f4'); poly2.setAttribute('stroke', '#d6d3d1');
                poly3.setAttribute('fill', '#fafaf9'); poly3.setAttribute('stroke', '#e7e5e4');
            }
        }

        // 9. 精准农业处方更替 (处方落地)
        document.getElementById('lbl-presc-1').innerText = data.prescriptions.p1;
        document.getElementById('lbl-presc-2').innerText = data.prescriptions.p2;
        document.getElementById('lbl-presc-3').innerText = data.prescriptions.p3;

        // 10. 图表与数据表格替换
        renderChartsAndTables(data);

        // 11. 反演异常警告更替
        renderInferenceWarnings(data.warnings);

        // 12. RAG 检索知识更替
        document.getElementById('lbl-rag-summary').innerText = data.rag_summary;
        let ragSourcesHTML = `
            <h4 class="text-[10px] font-mono text-slate-400 uppercase tracking-wider">规程及引用标准文献:</h4>
            <ul id="wrapper-rag-sources" class="grid grid-cols-1 md:grid-cols-2 gap-2 text-xs text-slate-500 font-mono list-inside list-disc">
        `;
        data.rag_sources.forEach(src => {
            ragSourcesHTML += `<li class="truncate hover:text-slate-700 transition-colors print-text" title="${src}">${src}</li>`;
        });
        ragSourcesHTML += '</ul>';
        document.getElementById('container-rag-sources').innerHTML = ragSourcesHTML;

        // 13. 联合质量仪表更新
        renderConfidenceGauge(data);
    }

    function renderKpiCards(data) {
        const isB = data.task_type === 'baldness_detection';
        const isL = data.task_type === 'lai_inversion';
        const isH = data.task_type === 'crop_health_detection';
        const isY = data.task_type === 'yield_prediction';
        const isG = data.task_type === 'growth_monitoring';

        const lbl1 = document.getElementById('lbl-kpi-1-label');
        const val1 = document.getElementById('lbl-kpi-1-val');
        const unit1 = document.getElementById('lbl-kpi-1-unit');
        const code1 = document.getElementById('lbl-kpi-1-code');

        if (isB) {
            lbl1.innerText = "异常退化面积";
            val1.innerText = data.affected_area.toFixed(1);
            unit1.innerText = " 亩";
            code1.innerText = "SPECTRUM_ANOMALY";
        } else if (isL) {
            lbl1.innerText = "平均叶面积指数 (LAI)";
            val1.innerText = data.affected_area.toFixed(2);
            unit1.innerText = "";
            code1.innerText = "m²(LEAF) / m²(GROUND)";
        } else if (isH) {
            lbl1.innerText = "重度生理失绿面积";
            val1.innerText = data.affected_area.toFixed(1);
            unit1.innerText = " 亩";
            code1.innerText = "CHLOROPHYLL_LOSS";
        } else if (isY) {
            lbl1.innerText = "预测平均亩产";
            val1.innerText = data.affected_area.toFixed(1);
            unit1.innerText = " kg/亩";
            code1.innerText = "YIELD_ESTIMATE";
        } else if (isG) {
            lbl1.innerText = "监测落后面积";
            val1.innerText = data.affected_area.toFixed(1);
            unit1.innerText = " 亩";
            code1.innerText = "WEAK_GROWTH_AREA";
        }

        const lbl2 = document.getElementById('lbl-kpi-2-label');
        const val2 = document.getElementById('lbl-kpi-2-val');
        const unit2 = document.getElementById('lbl-kpi-2-unit');
        const code2 = document.getElementById('lbl-kpi-2-code');

        if (isB) {
            lbl2.innerText = "地物受损覆盖率";
            val2.innerText = (data.positive_ratio * 100).toFixed(1);
            unit2.innerText = " %";
            code2.innerText = "PIXEL_PURITY_RATIO";
        } else if (isL) {
            lbl2.innerText = "植被冠层通光率";
            val2.innerText = ((1 - Math.pow(0.45, data.affected_area)) * 100).toFixed(1);
            unit2.innerText = " %";
            code2.innerText = "CANOPY_TRANSMITTANCE";
        } else if (isH) {
            lbl2.innerText = "健康绿度总体占比";
            val2.innerText = ((1 - data.positive_ratio) * 100).toFixed(1);
            unit2.innerText = " %";
            code2.innerText = "VEGETATION_HEALTH_PCT";
        } else if (isY) {
            lbl2.innerText = "产量置信区间 (95%)";
            val2.innerText = `[${(data.affected_area * 0.93).toFixed(1)}-${(data.affected_area * 1.07).toFixed(1)}]`;
            unit2.innerText = " kg";
            code2.innerText = "CLIMATIC_UNCERTAINTY";
        } else if (isG) {
            lbl2.innerText = "弱苗覆盖占比";
            val2.innerText = (data.positive_ratio * 100).toFixed(1);
            unit2.innerText = " %";
            code2.innerText = "WEAK_GROWTH_RATIO";
        }

        // 估计损耗与多边形个数替换
        document.getElementById('lbl-kpi-loss-val').innerText = data.est_loss;
        document.getElementById('lbl-kpi-polygons-val').innerText = data.polygons;

        const infConf = document.getElementById('lbl-inf-confidence');
        infConf.innerText = `${(data.confidence * 100).toFixed(1)}%`;
        infConf.className = data.confidence >= 0.8 ? "text-emerald-950 print-text" : (data.confidence >= 0.5 ? "text-amber-900 print-text" : "text-red-900 print-text");
    }

    function renderChartsAndTables(data) {
        const chartWrapper = document.getElementById('wrapper-bar-chart');
        const tableBody = document.getElementById('wrapper-table-body');
        
        if (data.class_distribution.length === 0) {
            chartWrapper.innerHTML = `
                <div class="text-center py-12 text-slate-400 space-y-2">
                    <p class="text-xs">连续型物理反演拟合，无需进行要素离散解译</p>
                </div>
            `;
            document.getElementById('container-table-details').classList.add('hidden');
            return;
        }

        document.getElementById('container-table-details').classList.remove('hidden');

        // 生成图表 HTML
        let chartHTML = '';
        data.class_distribution.forEach(bar => {
            const targetBadge = bar.is_target ? `<span class="text-[9px] bg-slate-200 text-slate-700 border border-slate-300 px-1 py-0.1 rounded print-badge">核心对象</span>` : '';
            chartHTML += `
                <div class="space-y-1">
                    <div class="flex items-center justify-between text-xs">
                        <div class="flex items-center gap-2 font-medium">
                            <span class="w-2.5 h-2.5 rounded-sm" style="background-color: ${bar.color}"></span>
                            <span class="text-slate-600 print-text">${bar.label}</span>
                            ${targetBadge}
                        </div>
                        <span class="font-mono font-bold text-slate-800 print-text">${(bar.ratio * 100).toFixed(1)}%</span>
                    </div>
                    <div class="h-2 w-full bg-slate-200/60 rounded-full overflow-hidden print-track">
                        <div class="h-full rounded-full transition-all duration-1000 print-bar" 
                             style="width: ${bar.bar_height_pct}%; background-color: ${bar.color}">
                        </div>
                    </div>
                </div>
            `;
        });
        chartWrapper.innerHTML = chartHTML;

        // 生成详细数据明细表格
        let tableHTML = '';
        data.class_distribution.forEach(bar => {
            const rowClass = bar.is_target ? 'bg-slate-50/40' : '';
            const statusLabel = bar.is_target ? `<span class="px-2 py-0.5 bg-slate-100 text-slate-800 border border-slate-300 rounded text-[10px] font-semibold">核心异常</span>` : `<span class="text-slate-400 text-[10px]">地物要素</span>`;
            
            tableHTML += `
                <tr class="hover:bg-slate-50/50 transition-colors ${rowClass}">
                    <td class="py-2.5 px-4">
                        <span class="inline-block w-3.5 h-3.5 rounded-sm align-middle" style="background-color: ${bar.color}"></span>
                    </td>
                    <td class="py-2.5 px-4 font-medium text-slate-700">${bar.label}</td>
                    <td class="py-2.5 px-4 text-right font-mono">${bar.value.toLocaleString()}</td>
                    <td class="py-2.5 px-4 text-right font-mono text-slate-600">
                        ${((bar.value) * 0.1).toFixed(1)}
                    </td>
                    <td class="py-2.5 px-4 text-right font-mono font-semibold text-slate-700">${(bar.ratio * 100).toFixed(2)}%</td>
                    <td class="py-2.5 px-4 text-center">
                        ${statusLabel}
                    </td>
                </tr>
            `;
        });
        tableBody.innerHTML = tableHTML;
    }

    function renderInferenceWarnings(warns) {
        const box = document.getElementById('container-inf-warnings');
        if (warns.length === 0) {
            box.innerHTML = '';
            return;
        }

        let warnHTML = `
            <div class="mt-4 space-y-2">
                <h4 class="text-xs font-bold text-amber-950 flex items-center gap-1">
                    <span>⚠️ 遥感反演异常警示：</span>
                </h4>
        `;
        warns.forEach(warn => {
            warnHTML += `
                <div class="p-3 bg-amber-50/40 border-l-3 border-amber-700 rounded text-xs text-slate-700 flex items-center gap-2 print-card print-border">
                    <span class="font-mono text-amber-800 font-bold">[WARN_OP]</span>
                    <span class="print-text">${warn}</span>
                </div>
            `;
        });
        warnHTML += '</div>';
        box.innerHTML = warnHTML;
    }

    function renderConfidenceGauge(data) {
        const arc = document.getElementById('conf-gauge-arc');
        const pctText = document.getElementById('lbl-gauge-percent');
        const lblLabel = document.getElementById('lbl-gauge-label');
        
        const finalVal = data.final_confidence;
        const offset = 188.4 * (1.0 - finalVal);
        
        let color = '#475569';
        if (data.final_label === 'high') color = '#0f5132';
        else if (data.final_label === 'low') color = '#991b1b';

        arc.setAttribute('stroke', color);
        arc.setAttribute('stroke-dashoffset', offset);
        
        pctText.style.color = color;
        pctText.innerHTML = `${Math.round(finalVal * 100)}<span class="text-xs font-semibold">%</span>`;
        
        lblLabel.style.color = color;
        lblLabel.style.borderColor = `${color}40`;
        lblLabel.style.backgroundColor = `${color}08`;
        lblLabel.innerText = data.final_label.toUpperCase();

        // 四维指标进度条替换
        document.getElementById('lbl-conf-image').innerText = `${(data.image_confidence * 100).toFixed(1)}%`;
        document.getElementById('bar-conf-image').style.width = `${data.image_confidence * 100}%`;

        document.getElementById('lbl-conf-text').innerText = `${(data.text_confidence * 100).toFixed(1)}%`;
        document.getElementById('bar-conf-text').style.width = `${data.text_confidence * 100}%`;

        document.getElementById('lbl-conf-workflow').innerText = `${(data.workflow_confidence * 100).toFixed(1)}%`;
        document.getElementById('bar-conf-workflow').style.width = `${data.workflow_confidence * 100}%`;

        const lblFinal = document.getElementById('lbl-conf-final');
        lblFinal.innerText = `${(finalVal * 100).toFixed(1)}%`;
        document.getElementById('bar-conf-final').style.width = `${finalVal * 100}%`;

        document.getElementById('lbl-conf-explanation').innerText = data.explanation;

        // 系统警告重设
        const sysWarnBox = document.getElementById('container-conf-warnings');
        if (data.conf_warnings.length === 0) {
            sysWarnBox.innerHTML = '';
            return;
        }

        let sysWarnHTML = '<div class="mt-4 space-y-2">';
        data.conf_warnings.forEach(warn => {
            sysWarnHTML += `
                <div class="p-3 bg-red-50/60 border-l-3 border-red-700 rounded text-xs text-slate-700 flex items-center gap-2 print-card print-border">
                    <span class="font-mono text-red-800 font-bold">[ENGINE_WARN]</span>
                    <span class="print-text">${warn}</span>
                </div>
            `;
        });
        sysWarnHTML += '</div>';
        sysWarnBox.innerHTML = sysWarnHTML;
    }

    function getTaskBadgeHTML(task) {
        if (task === 'baldness_detection') return `<span class="badge px-3 py-1 bg-emerald-50 text-emerald-950 border border-emerald-200 rounded-md font-semibold print-badge">斑秃识别检测</span>`;
        if (task === 'lai_inversion') return `<span class="badge px-3 py-1 bg-blue-50 text-blue-950 border border-blue-200 rounded-md font-semibold print-badge">叶面积指数反演 (LAI)</span>`;
        if (task === 'crop_health_detection') return `<span class="badge px-3 py-1 bg-teal-50 text-teal-950 border border-teal-200 rounded-md font-semibold print-badge">生理健康监测</span>`;
        if (task === 'yield_prediction') return `<span class="badge px-3 py-1 bg-amber-50 text-amber-950 border border-amber-200 rounded-md font-semibold print-badge">定量产量预测</span>`;
        return `<span class="badge px-3 py-1 bg-stone-100 text-stone-900 border border-stone-200 rounded-md font-semibold print-badge">生长进程监测</span>`;
    }

    function getCropZH(crop) {
        if (crop === 'wheat') return '冬小麦 (Wheat)';
        if (crop === 'corn') return '夏玉米 (Corn)';
        if (crop === 'rice') return '水稻 (Rice)';
        return crop;
    }
