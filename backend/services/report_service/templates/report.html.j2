    <style>
        /* 字体变量覆盖：确保 Inter 和 Noto Serif SC 优先 */
        :root {
            --font-sans: 'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif;
            --font-serif: 'Noto Serif SC', 'STSong', 'SimSun', Georgia, serif;
        }

        /* 极致简约：去除任何"太空、科技、暗黑"风格，模拟高档学术纸张质感 */
        body {
            background-color: #f8fafc;
            color: #1e293b;
            font-feature-settings: "cv02", "cv03", "cv04", "cv11";
        }
        
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

        /* 打印模式深度纯化：完美的黑白学术报告格式 */
        @media print {
            body {
                background: #ffffff !important;
                color: #000000 !important;
                font-family: 'Noto Serif SC', 'STSong', 'SimSun', Georgia, serif !important;
                padding: 0 !important;
            }
            .container {
                max-width: 100% !important;
                width: 100% !important;
                margin: 0 !important;
                padding: 0 !important;
            }
            .no-print {
                display: none !important;
            }
            .print-card {
                background: #ffffff !important;
                border: 1px solid #94a3b8 !important;
                box-shadow: none !important;
                border-radius: 0 !important;
                margin-bottom: 1.5rem !important;
                page-break-inside: avoid !important;
            }
            .print-title {
                color: #000000 !important;
                border-bottom: 2px solid #000000 !important;
                font-weight: 700 !important;
            }
            .print-text {
                color: #111111 !important;
            }
            .print-badge {
                border: 1px solid #000000 !important;
                background: transparent !important;
                color: #000000 !important;
                border-radius: 0 !important;
            }
            .print-bar {
                background-color: #475569 !important;
            }
            .print-track {
                background-color: #e2e8f0 !important;
                border: 1px solid #94a3b8 !important;
            }
        }
    </style>
</head>
<body class="font-sans antialiased min-h-screen py-10 px-4 md:px-8">
{% set is_baldness = request.task_type == 'baldness_detection' %}
{% set is_health = request.task_type == 'crop_health_detection' %}
{% set is_lai = request.task_type in ['lai_estimation', 'lai_inversion'] %}
{% set is_yield = request.task_type in ['yield_prediction', 'yield_estimation'] %}
{% set is_growth = request.task_type == 'growth_monitoring' %}
{% set pixel_to_mu = extra.pixel_to_mu_ratio | default(0.1) %}


<!-- ==========================================================================
   仿真实时演示面板（仅用于非Python后端容器打开时渲染，发布时后台不渲染）
   ========================================================================== -->
<div id="preview-control-panel" class="no-print max-w-6xl mx-auto mb-6 bg-white border border-slate-200 p-4 rounded-xl shadow-sm hidden">
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        <div class="flex items-center gap-3">
            <span class="flex h-3 w-3 relative">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-700"></span>
            </span>
            <div>
                <h4 class="text-xs font-bold text-slate-900 flex items-center gap-2">
                    GeoAI 综合遥感高级决策报告沙箱 (Jinja2 Hybrid)
                    <span class="text-[9px] font-mono font-normal text-slate-500 bg-slate-100 px-1.5 py-0.5 rounded border border-slate-200">Local Sandbox Active</span>
                </h4>
                <p class="text-[11px] text-slate-500 mt-0.5">检测到未渲染的 Jinja2 标签，已自动激活本地仿真数据库，您可以任意切换大尺度遥感分析场景。</p>
            </div>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <span class="text-xs text-slate-600 font-medium">地理决策场景:</span>
            <select id="scenario-selector" class="bg-slate-50 border border-slate-300 text-xs text-slate-700 rounded-lg px-3 py-1.5 focus:ring-1 focus:ring-emerald-700 focus:outline-none transition cursor-pointer font-medium">
                <option value="baldness_detection">🌾 河南省浚县夏小麦：冬前退化斑秃与断垄测绘</option>
                <option value="lai_inversion">🌽 山东省齐河县夏玉米：大喇叭口期冠层叶面积指数 (LAI) 精确反演</option>
                <option value="crop_health_detection">🌾 黑龙江建三江农场：水稻灌浆期冷温生理健康与叶枯隐患检测</option>
                <option value="yield_prediction">🌽 吉林省公主岭示范区：春玉米多源同化理论单产评估与丰产级分类</option>
                <option value="growth_monitoring">🌾 湖南省常德鼎城区：晚稻拔节前分蘖跃进期生长进程追踪</option>
            </select>
        </div>
    </div>
</div>

<div class="container max-w-6xl mx-auto space-y-6">

    <!-- ==========================================================================
       SECTION 1: 报告页眉 (双层学术版式)
       ========================================================================== -->
    <header class="flex flex-col md:flex-row md:items-end md:justify-between pb-6 border-b-2 border-slate-900 gap-4">
        <div class="space-y-3 flex-1">
            <div class="flex items-center gap-3">
                <span class="p-2 bg-slate-100 border border-slate-200 rounded-lg text-slate-700 no-print">
                    <!-- 简约测绘仪罗盘 -->
                    <svg class="w-5 h-5 text-emerald-900" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <path d="M16.2 7.8l-2 6.3-6.4 2.1 2.1-6.4z"></path>
                    </svg>
                </span>
                <h1 id="lbl-title" class="text-xl md:text-2xl font-black tracking-tight text-slate-900 print-title font-serif">
                    {{ request.title | default('智能遥感光谱分析报告') }}
                </h1>
            </div>
            
            <div class="flex flex-wrap items-center gap-2 text-xs">
                <span id="lbl-task-badge">
                    {% if request.task_type %}
                        {% if is_baldness %}
                            <span class="badge px-3 py-1 bg-emerald-50 text-emerald-900 border border-emerald-200 rounded-md font-semibold print-badge">斑秃识别检测</span>
                        {% elif is_health %}
                            <span class="badge px-3 py-1 bg-teal-50 text-teal-900 border border-teal-200 rounded-md font-semibold print-badge">生理健康状况监测</span>
                        {% elif is_lai %}
                            <span class="badge px-3 py-1 bg-blue-50 text-blue-950 border border-blue-200 rounded-md font-semibold print-badge">叶面积指数反演 (LAI)</span>
                        {% elif is_yield %}
                            <span class="badge px-3 py-1 bg-amber-50 text-amber-950 border border-amber-200 rounded-md font-semibold print-badge">定量产量测算预测</span>
                        {% elif is_growth %}
                            <span class="badge px-3 py-1 bg-stone-100 text-stone-900 border border-stone-200 rounded-md font-semibold print-badge">关键生长阶段监测</span>
                        {% else %}
                            <span class="badge px-3 py-1 bg-slate-100 text-slate-700 border border-slate-200 rounded-md font-semibold print-badge">{{ request.task_type }}</span>
                        {% endif %}
                    {% endif %}
                </span>

                {% if request.region %}
                    <span id="lbl-region-badge" class="badge px-3 py-1 bg-slate-100 text-slate-600 border border-slate-200/60 rounded-md print-badge">
                        监测区域: {{ request.region | upper }}
                    </span>
                {% endif %}

                {% if request.crop_type %}
                    <span id="lbl-crop-badge" class="badge px-3 py-1 bg-slate-100 text-slate-600 border border-slate-200/60 rounded-md print-badge">
                        作物类型: {% if request.crop_type == 'wheat' %}冬小麦 (Wheat)
                                 {% elif request.crop_type == 'corn' %}夏玉米 (Corn)
                                 {% elif request.crop_type == 'rice' %}水稻 (Rice)
                                 {% else %}{{ request.crop_type | capitalize }}
                                 {% endif %}
                    </span>
                {% endif %}
            </div>
        </div>

        <div class="text-left md:text-right font-mono text-[11px] text-slate-500 space-y-1">
            <div class="flex items-center md:justify-end gap-2">
                <span>流水验证编号:</span>
                <span id="lbl-request-id" class="px-2 py-0.5 bg-slate-100 border border-slate-200 text-slate-700 rounded font-semibold print-badge">{{ request.request_id | default('REQ-N/A') }}</span>
            </div>
            <div>
                <span>解译生成时间:</span>
                <span id="lbl-generated-at" class="text-slate-800 font-semibold">{{ generated_at | default('N/A') }}</span>
            </div>
        </div>
    </header>

    <!-- ==========================================================================
       SECTION 2: 多源数据源及大区环境背景 (新增：让报告极具专业大局观)
       ========================================================================== -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="bg-white border border-slate-200 rounded-xl p-4 shadow-sm print-card flex flex-col justify-between">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block mb-1">主传感器传感器组</span>
            <span id="lbl-sensor-opt" class="text-sm font-bold text-slate-800 font-mono block print-text">{{ extra.sensors.opt | default('Sentinel-2 MSI (10M)') }}</span>
            <span class="text-[10px] text-slate-500 block mt-2">光谱覆盖：B2-B8A 红边敏锐通道</span>
        </div>
        <div class="bg-white border border-slate-200 rounded-xl p-4 shadow-sm print-card flex flex-col justify-between">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block mb-1">测控微波雷达校正</span>
            <span id="lbl-sensor-sar" class="text-sm font-bold text-slate-800 font-mono block print-text">{{ extra.sensors.sar | default('Sentinel-1 C-SAR (VV/VH)') }}</span>
            <span class="text-[10px] text-slate-500 block mt-2">偏振校正：穿透消融云雾物理拟合</span>
        </div>
        <div class="bg-white border border-slate-200 rounded-xl p-4 shadow-sm print-card flex flex-col justify-between">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block mb-1">累积日照积温偏置</span>
            <span id="lbl-weather-gdd" class="text-sm font-bold text-emerald-800 font-mono block print-text">{{ extra.sensors.gdd | default('+42.5 ℃·d (偏旺)') }}</span>
            <span class="text-[10px] text-slate-500 block mt-2">气象对齐：对标常年气象中数均线</span>
        </div>
        <div class="bg-white border border-slate-200 rounded-xl p-4 shadow-sm print-card flex flex-col justify-between">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block mb-1">微波土壤绝对湿度</span>
            <span id="lbl-soil-moisture" class="text-sm font-bold text-slate-800 font-mono block print-text">{{ extra.sensors.sm | default('24.8 % (适墒)') }}</span>
            <span class="text-[10px] text-slate-500 block mt-2">微波反演：SMAP 主动土壤湿度剖面</span>
        </div>
    </div>

    <!-- ==========================================================================
       SECTION 3: 概述与双向深度分析区 (增产优势 VS 灾损限制，兼顾积极与消极方面)
       ========================================================================== -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- 基础学术概述 -->
        <div class="lg:col-span-7 bg-white border border-slate-200 rounded-xl p-6 shadow-sm hover:border-slate-300 transition duration-200 print-card">
            <h2 class="text-sm font-bold text-slate-900 tracking-wide uppercase mb-4 flex items-center gap-2 pb-2 border-b border-slate-100 print-title">
                <svg class="w-4 h-4 text-emerald-950" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path d="M4 6h16M4 12h16M4 18h7"></path>
                </svg>
                数据解析背景与遥感概述
            </h2>
            
            {% if request.user_query %}
                <div id="container-user-query" class="mb-4 p-3 bg-slate-50 border-l-3 border-emerald-900 rounded text-xs text-slate-600 font-sans italic print-card">
                    <span class="text-slate-800 font-bold not-italic">解译目的对齐：</span> "<span id="lbl-user-query">{{ request.user_query }}</span>"
                </div>
            {% endif %}
            
            <p id="lbl-overview" class="font-serif text-[14px] leading-relaxed text-slate-700 text-justify indent-8 print-text">
                {{ request.summary.overview | default('本研究报告是由高空间分辨率多源多光谱卫星传感器影像、物理电磁波散射同化算子，协同地表农业物候生长动态函数共同解译所得的定量科学成果。通过精密的光谱辐照校正、去云霾遮蔽重建以及归一化差异红边敏感通道反演，全面提取监测农田地块层面的植被指数变动，以此透析目标群落的宏观生理健康演变与生理逆境胁迫状况。') }}
            </p>
        </div>

        <!-- 核心结论决策支持 -->
        <div class="lg:col-span-5 bg-white border border-slate-200 rounded-xl p-6 shadow-sm hover:border-slate-300 transition duration-200 print-card">
            <h2 class="text-sm font-bold text-slate-900 tracking-wide uppercase mb-4 flex items-center gap-2 pb-2 border-b border-slate-100 print-title">
                <svg class="w-4 h-4 text-emerald-950" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                核心分析结论
            </h2>
            
            <div id="container-key-findings">
                {% if request.summary.key_findings %}
                    <ul class="space-y-3">
                        {% for finding in request.summary.key_findings %}
                            <li class="flex items-start gap-3">
                                <span class="flex-shrink-0 w-5 h-5 rounded bg-emerald-50 text-emerald-900 flex items-center justify-center text-[10px] font-bold border border-emerald-100 no-print">
                                    {{ loop.index }}
                                </span>
                                <span class="text-xs text-slate-600 leading-relaxed print-text">{{ finding }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <div class="flex flex-col items-center justify-center h-40 text-slate-400">
                        <p class="text-xs">暂无结构化发现列表</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <!-- 积极增产分析 VS 消极灾害胁迫 (新增: 双向大格局辩证透析) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- 优势增产潜力 (Positive Factors) -->
        <div class="bg-white border border-emerald-100 rounded-xl p-5 shadow-sm print-card">
            <h3 class="text-xs font-extrabold text-emerald-950 uppercase tracking-widest flex items-center gap-2 mb-3 pb-1 border-b border-emerald-50 print-title">
                <span class="w-1.5 h-3 bg-emerald-700 inline-block rounded-sm"></span>
                地表积极优势与丰产区分析 (Yield Potential)
            </h3>
            <p id="lbl-positive-text" class="text-xs text-slate-600 leading-relaxed text-justify print-text">
                {{ extra.positive_analysis | default('监测范围内高郁闭度和高生物量积累地块占比可喜，部分区域表现出极强的光合效能与合理物候进阶。由于基底土墒配比均衡，在作物营养转化和冠层扩展上优势显著。若能维持当前微环境持水量，其干物质转化比率处于极高水平，具备优异的后期单产增量红利空间。') }}
            </p>
        </div>

        <!-- 胁迫灾损及生产限制 (Negative Constraints) -->
        <div class="bg-white border border-amber-100 rounded-xl p-5 shadow-sm print-card">
            <h3 class="text-xs font-extrabold text-amber-950 uppercase tracking-widest flex items-center gap-2 mb-3 pb-1 border-b border-amber-50 print-title">
                <span class="w-1.5 h-3 bg-amber-700 inline-block rounded-sm"></span>
                逆境生理胁迫与减损风险评估 (Stress & Constraints)
            </h3>
            <p id="lbl-negative-text" class="text-xs text-slate-600 leading-relaxed text-justify print-text">
                {{ extra.negative_analysis | default('受局部降水空间异质性、高沙化土壤漏肥效应以及局部隐性病损（如冷温叶枯）的共同消极抑制。偏弱、发黄脱水的亚健康区域呈现集中破碎分布，这些区域的叶片含水量指数（NDWI）显著滑坡，长势等级处于轻至重度胁迫。若在即将步入的发育转折期不予水肥偏置调配，可能导致总体单产潜能下滑5%-10%。') }}
            </p>
        </div>
    </div>

    <!-- ==========================================================================
       SECTION 4: 遥感光谱反演核心结果 (极简、高白度排版)
       ========================================================================== -->
    {% if request.inference is not none %}
        <section id="section-inference" class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm print-card">
            
            <div class="flex items-center justify-between mb-6 pb-2 border-b border-slate-100 print-title">
                <h2 class="text-sm font-bold text-slate-900 tracking-wide uppercase flex items-center gap-2">
                    <svg class="w-4 h-4 text-emerald-950" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                        <polyline points="2 17 12 22 22 17"></polyline>
                        <polyline points="2 12 12 17 22 12"></polyline>
                    </svg>
                    反演定量测算指标
                </h2>
                <div class="text-[10px] font-mono text-slate-400 hidden md:block">
                    BACKEND_MODEL: <span id="lbl-model-name" class="font-semibold text-slate-600">{{ request.inference.model_name | default('SpatialAI-Engine') }}</span>
                </div>
            </div>

            <!-- 六栏简约核心指标卡片 -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-4 mb-6">
                <!-- KPI 1 -->
                <div class="relative bg-slate-50/60 border border-slate-200/80 p-4 rounded-lg flex flex-col justify-between h-24 print-card">
                    <div id="lbl-kpi-1-label" class="text-[10px] font-extrabold text-slate-500 tracking-wider uppercase">
                        {% if is_baldness %}异常退化面积
                        {% elif is_lai %}平均叶面积指数 (LAI)
                        {% elif is_health %}重度生理失绿面积
                        {% elif is_yield %}预测平均亩产
                        {% elif is_growth %}监测落后面积
                        {% else %}地物光谱关联面积
                        {% endif %}
                    </div>
                    <div class="text-xl font-black tracking-tight text-slate-950 print-text">
                        <span id="lbl-kpi-1-val">
                            {% if is_lai %}
                                {{ (request.inference.affected_area | default(0.0)) | round(2) }}
                            {% else %}
                                {{ (request.inference.affected_area | default(0.0)) | round(1) }}
                            {% endif %}
                        </span>
                        <span id="lbl-kpi-1-unit" class="text-xs font-normal text-slate-500">
                            {% if is_lai %}{% else %}{% if is_yield %}kg/亩{% else %}亩{% endif %}{% endif %}
                        </span>
                    </div>
                    <div id="lbl-kpi-1-code" class="text-[9px] text-slate-400 font-mono">
                        {% if is_baldness %}SPECTRUM_ANOMALY
                        {% elif is_lai %}m²(LEAF) / m²(GROUND)
                        {% elif is_health %}CHLOROPHYLL_LOSS
                        {% elif is_yield %}YIELD_ESTIMATE
                        {% elif is_growth %}WEAK_GROWTH_AREA
                        {% else %}PHYSICAL_INVERSION
                        {% endif %}
                    </div>
                </div>

                <!-- KPI 2 -->
                <div class="relative bg-slate-50/60 border border-slate-200/80 p-4 rounded-lg flex flex-col justify-between h-24 print-card">
                    <div id="lbl-kpi-2-label" class="text-[10px] font-extrabold text-slate-500 tracking-wider uppercase">
                        {% if is_baldness %}地物受损覆盖率
                        {% elif is_lai %}植被冠层通光率
                        {% elif is_health %}健康绿度总体占比
                        {% elif is_yield %}产量置信区间 (95%)
                        {% elif is_growth %}弱苗覆盖占比
                        {% else %}目标解译像元占比
                        {% endif %}
                    </div>
                    <div class="text-xl font-bold tracking-tight text-slate-900 print-text">
                        <span id="lbl-kpi-2-val">
                            {% if is_yield %}
                                [{{ ((request.inference.affected_area | default(0.0)) * 0.93) | round(1) }}-{{ ((request.inference.affected_area | default(0.0)) * 1.07) | round(1) }}]
                            {% elif is_lai %}
                                {{ ((1 - (0.45 ** (request.inference.affected_area | default(1.0)))) * 100) | round(1) }}
                            {% elif is_health %}
                                {{ ((1 - (request.inference.positive_ratio | default(0.0))) * 100) | round(1) }}
                            {% else %}
                                {{ ((request.inference.positive_ratio | default(0.0)) * 100) | round(1) }}
                            {% endif %}
                        </span>
                        <span id="lbl-kpi-2-unit" class="text-xs font-normal text-slate-500">
                            {% if is_yield %}kg{% else %}%{% endif %}
                        </span>
                    </div>
                    <div id="lbl-kpi-2-code" class="text-[9px] text-slate-400 font-mono">
                        {% if is_yield %}CLIMATIC_UNCERTAINTY{% elif is_growth %}WEAK_GROWTH_RATIO{% else %}PIXEL_PURITY_RATIO{% endif %}
                    </div>
                </div>

                <!-- KPI 3 -->
                <div class="relative bg-slate-50/60 border border-slate-200/80 p-4 rounded-lg flex flex-col justify-between h-24 print-card">
                    <div class="text-[10px] font-extrabold text-slate-500 tracking-wider uppercase">定量估值置信概率</div>
                    <div class="text-xl font-bold tracking-tight">
                        {% set inf_conf = request.inference.confidence | default(0.0) %}
                        <span id="lbl-inf-confidence" class="{% if inf_conf >= 0.8 %}text-emerald-900{% elif inf_conf >= 0.5 %}text-amber-900{% else %}text-red-900{% endif %} print-text">
                            {{ (inf_conf * 100) | round(1) }}%
                        </span>
                    </div>
                    <div class="text-[9px] text-slate-400 font-mono">SPATIAL_CONF_INDEX</div>
                </div>

                <!-- KPI 4 -->
                <div class="relative bg-slate-50/60 border border-slate-200/80 p-4 rounded-lg flex flex-col justify-between h-24 print-card">
                    <div class="text-[10px] font-extrabold text-slate-500 tracking-wider uppercase">估计总体损耗</div>
                    <div class="text-xl font-bold tracking-tight text-slate-900 print-text">
                        <span id="lbl-kpi-loss-val">{{ extra.est_loss | default('~5.4') }}</span>
                        <span class="text-xs font-normal text-slate-500">%</span>
                    </div>
                    <div class="text-[9px] text-slate-400 font-mono">EST_ECONOMIC_LOSS</div>
                </div>

                <!-- KPI 5 -->
                <div class="relative bg-slate-50/60 border border-slate-200/80 p-4 rounded-lg flex flex-col justify-between h-24 print-card">
                    <div class="text-[10px] font-extrabold text-slate-500 tracking-wider uppercase">检测区域地块群</div>
                    <div class="text-xl font-bold tracking-tight text-slate-900 print-text">
                        <span id="lbl-kpi-polygons-val">{{ chart_context.area_breakdown.polygon_count | default(0) }}</span>
                        <span class="text-xs font-normal text-slate-500">处</span>
                    </div>
                    <div class="text-[9px] text-slate-400 font-mono">SPATIAL_POLYGONS</div>
                </div>

                <!-- KPI 6 -->
                <div class="relative bg-slate-50/60 border border-slate-200/80 p-4 rounded-lg flex flex-col justify-between h-24 print-card">
                    <div class="text-[10px] font-extrabold text-slate-500 tracking-wider uppercase">运算法则引擎</div>
                    <div id="lbl-model-name-short" class="text-xs font-bold text-slate-700 font-mono truncate print-text" title="{{ request.inference.model_name }}">
                        {{ request.inference.model_name | default('GeoSegNet') }}
                    </div>
                    <div class="text-[9px] text-slate-500 font-mono bg-slate-200/60 border border-slate-300/60 px-1.5 py-0.5 rounded self-start print-badge">
                        V: <span id="lbl-model-version">{{ request.inference.model_version | default('v2.5.1') }}</span>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
                <!-- GIS 遥感高级测绘控制台 (高档浅象牙色作图底面，完全摒弃荧光霓虹) -->
                <div class="lg:col-span-7 flex flex-col">
                    <div class="flex items-center justify-between text-[10px] font-mono text-slate-400 mb-2">
                        <span>GEOGRAPHIC_SPATIAL_PLOT // TOPOLOGY_LAYER</span>
                        <span id="gis-coords">COORDS: {{ extra.gis_coords | default('34.0294° N, 113.4829° E') }} | SCALE 1:50,000</span>
                    </div>
                    
                    <div id="gis-viewport" class="relative flex-1 bg-[#FAF9F5] border border-slate-200 rounded-lg overflow-hidden flex items-center justify-center p-4 min-h-[300px] cursor-crosshair group print-raster">
                        <!-- 四角测绘点定位标记 -->
                        <div class="absolute top-2.5 left-2.5 w-3 h-3 border-t border-l border-slate-400 no-print"></div>
                        <div class="absolute top-2.5 right-2.5 w-3 h-3 border-t border-r border-slate-400 no-print"></div>
                        <div class="absolute bottom-2.5 left-2.5 w-3 h-3 border-b border-l border-slate-400 no-print"></div>
                        <div class="absolute bottom-2.5 right-2.5 w-3 h-3 border-b border-r border-slate-400 no-print"></div>

                        <!-- 地理影像呈现 -->
                        <div class="w-full flex items-center justify-center">
                            {% if request.inference.mask_uri %}
                                <img src="{{ request.inference.mask_uri }}" alt="遥感解译图" onerror="this.onerror=null; this.outerHTML='<div class=\'text-xs text-slate-400\'>[解译掩膜脱机，已载入拓扑图层]</div>';" class="max-h-[240px] object-contain rounded border border-slate-200 shadow-sm"/>
                            {% else %}
                                <!-- 高精细地物拓扑地理测绘地图 (高雅莫兰迪浅色系统) -->
                                <svg id="gis-svg" class="w-full max-w-sm h-auto opacity-95 text-slate-600" viewBox="0 0 200 140" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <rect width="200" height="140" fill="#f9f7f0" />
                                    <!-- 测绘极细分经纬网格 -->
                                    <path d="M 0 20 L 200 20 M 0 40 L 200 40 M 0 60 L 200 60 M 0 80 L 200 80 M 0 100 L 200 100 M 0 120 L 200 120" stroke="#f0ead9" stroke-width="0.5"/>
                                    <path d="M 20 0 L 20 140 M 40 0 L 40 140 M 60 0 L 60 140 M 80 0 L 80 140 M 100 0 L 100 140 M 120 0 L 120 140 M 140 0 L 140 140 M 160 0 L 160 140 M 180 0 L 180 140" stroke="#f0ead9" stroke-width="0.5"/>

                                    <!-- 多级样方分割 (利用低饱和莫兰迪草木绿、熟褐、沙土黄) -->
                                    <polygon id="gis-poly-1" points="30,25 140,20 165,55 110,115 50,100 25,55" fill="#e2efe5" stroke="#9bbda5" stroke-width="0.8" />
                                    <polygon id="gis-poly-2" points="80,35 125,30 145,65 100,85" fill="#f8ece4" stroke="#d5b099" stroke-width="0.8" />
                                    <polygon id="gis-poly-3" points="50,60 80,55 90,80 60,85" fill="#fcf9ec" stroke="#d4cb9f" stroke-width="0.6" />
                                    
                                    <!-- 乡村道路和灌溉渠网 -->
                                    <path d="M 0 80 C 60 85, 130 75, 200 85" stroke="#ded4c1" stroke-width="1.2" />
                                    <path d="M 105 0 L 105 140" stroke="#ded4c1" stroke-width="0.6" stroke-dasharray="3 3" />

                                    <!-- 物理标注点 -->
                                    <circle cx="115" cy="55" r="2.5" fill="#991b1b" opacity="0.8"/>
                                    <text x="122" y="58" fill="#991b1b" font-size="4" font-family="sans-serif" font-weight="700">CORE ANOMALY</text>
                                    <line x1="115" y1="55" x2="122" y2="57" stroke="#991b1b" stroke-width="0.5" />
                                    
                                    <!-- 测绘指北针 -->
                                    <g transform="translate(182, 16) scale(0.65)">
                                        <circle cx="10" cy="10" r="8" stroke="#94a3b8" stroke-width="0.8"/>
                                        <path d="M10 4 L12 11 L10 10 L8 11 Z" fill="#475569" />
                                        <text x="8.5" y="3" fill="#475569" font-size="4" font-weight="bold" font-family="sans-serif">N</text>
                                    </g>
                                    <!-- 比例尺 -->
                                    <g transform="translate(15, 122)">
                                        <line x1="0" y1="2" x2="30" y2="2" stroke="#475569" stroke-width="0.8" />
                                        <line x1="0" y1="0" x2="0" y2="4" stroke="#475569" stroke-width="0.8" />
                                        <line x1="15" y1="0" x2="15" y2="4" stroke="#475569" stroke-width="0.8" />
                                        <line x1="30" y1="0" x2="30" y2="4" stroke="#475569" stroke-width="0.8" />
                                        <text x="34" y="4" fill="#475569" font-size="4.5" font-family="monospace">500m</text>
                                    </g>
                                </svg>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <!-- 空间分区占比与学术图例 -->
                <div class="lg:col-span-5 flex flex-col justify-between">
                    <div class="space-y-4">
                        <div class="text-[10px] font-mono text-slate-400">
                            <span>CLASS_DISTRIBUTION // 空间异质分区统计</span>
                        </div>
                        
                        <div id="container-chart-box" class="bg-slate-50 border border-slate-200/80 rounded-lg p-5 space-y-4 print-card">
                            <div id="wrapper-bar-chart" class="space-y-4">
                                {% if chart_context.class_distribution_chart %}
                                    {% for bar in chart_context.class_distribution_chart %}
                                        <div class="space-y-1">
                                            <div class="flex items-center justify-between text-xs">
                                                <div class="flex items-center gap-2 font-medium">
                                                    <span class="w-2.5 h-2.5 rounded-sm" style="background-color: {{ bar.color | default('#475569') }}"></span>
                                                    <span class="text-slate-600 print-text">{{ bar.label }}</span>
                                                    {% if bar.is_target %}
                                                        <span class="text-[9px] bg-slate-200 text-slate-700 border border-slate-300 px-1 py-0.1 rounded print-badge">主关注对象</span>
                                                    {% endif %}
                                                </div>
                                                <span class="font-mono font-bold text-slate-800 print-text">{{ (bar.ratio * 100) | round(1) }}%</span>
                                            </div>
                                            <div class="h-2 w-full bg-slate-200/60 rounded-full overflow-hidden print-track">
                                                <div class="h-full rounded-full transition-all duration-1000 print-bar" 
                                                     style="width: {{ bar.bar_height_pct | default(bar.ratio * 100) }}%; background-color: {{ bar.color | default('#475569') }}">
                                                </div>
                                            </div>
                                        </div>
                                    {% endfor %}
                                {% else %}
                                    <div class="text-center py-12 text-slate-400 space-y-2">
                                        <p class="text-xs">该场景属物理拟合反演，无离散要素统计数据</p>
                                    </div>
                                {% endif %}
                            </div>
                        </div>

                        <!-- 测绘图例说明 (新增：学术报告规范) -->
                        <div class="p-3.5 bg-slate-50 border border-slate-200/60 rounded-lg no-print">
                            <span class="text-[9px] font-bold text-slate-400 tracking-wider block mb-2 uppercase">测绘图例及反射参数说明</span>
                            <div class="grid grid-cols-2 gap-2 text-[11px] text-slate-500">
                                <div class="flex items-center gap-2">
                                    <span class="w-3 h-1.5 bg-[#e2efe5] border border-[#9bbda5] rounded-xs"></span>
                                    <span>正常丰产指数区</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="w-3 h-1.5 bg-[#f8ece4] border border-[#d5b099] rounded-xs"></span>
                                    <span>逆境异常胁迫区</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="w-3 h-1.5 bg-[#fcf9ec] border border-[#d4cb9f] rounded-xs"></span>
                                    <span>低植被裸土背景</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="w-3.5 h-1 stroke-2 border-b border-dashed border-slate-400"></span>
                                    <span>沟渠路网排干系统</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 数据明细统计表格 (极简学术表格) -->
            <div id="container-table-details" class="mt-6 border border-slate-200 rounded-lg overflow-hidden no-print">
                <table class="w-full text-xs text-left text-slate-600">
                    <thead class="bg-slate-50 font-mono text-slate-500 border-b border-slate-200">
                        <tr>
                            <th class="py-2.5 px-4 font-semibold">色块</th>
                            <th class="py-2.5 px-4 font-semibold">解译分类区段</th>
                            <th class="py-2.5 px-4 font-semibold text-right">网格像元计数 (Count)</th>
                            <th class="py-2.5 px-4 font-semibold text-right">面积折算 (亩)</th>
                            <th class="py-2.5 px-4 font-semibold text-right">空间占比 (Ratio)</th>
                            <th class="py-2.5 px-4 font-semibold text-center">分类性质</th>
                        </tr>
                    </thead>
                    <tbody id="wrapper-table-body" class="divide-y divide-slate-100 bg-white">
                        {% if chart_context.class_distribution_chart %}
                            {% for bar in chart_context.class_distribution_chart %}
                                <tr class="hover:bg-slate-50/50 transition-colors {% if bar.is_target %}bg-slate-50/40{% endif %}">
                                    <td class="py-2.5 px-4">
                                        <span class="inline-block w-3.5 h-3.5 rounded-sm align-middle" style="background-color: {{ bar.color | default('#475569') }}"></span>
                                    </td>
                                    <td class="py-2.5 px-4 font-medium text-slate-700">{{ bar.label }}</td>
                                    <td class="py-2.5 px-4 text-right font-mono">{{ bar.value | default('0') }}</td>
                                    <td class="py-2.5 px-4 text-right font-mono text-slate-600">
                                        {{ ((bar.value | default(0) | float) * pixel_to_mu) | round(1) }}
                                    </td>
                                    <td class="py-2.5 px-4 text-right font-mono font-semibold text-slate-700">{{ (bar.ratio * 100) | round(2) }}%</td>
                                    <td class="py-2.5 px-4 text-center">
                                        {% if bar.is_target %}
                                            <span class="px-2 py-0.5 bg-slate-100 text-slate-800 border border-slate-300 rounded text-[10px] font-semibold">核心异常区</span>
                                        {% else %}
                                            <span class="text-slate-400 text-[10px]">常态地物要素</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        {% else %}
                            <tr>
                                <td colspan="6" class="py-4 text-center text-slate-400 italic">无可用定量分类要素数据</td>
                            </tr>
                        {% endif %}
                    </tbody>
                </table>
            </div>

            <!-- 质量预警信息 -->
            <div id="container-inf-warnings">
                {% if request.inference.warnings %}
                    <div class="mt-4 space-y-2">
                        <h4 class="text-xs font-bold text-amber-900 flex items-center gap-1">
                            <span>⚠️ 反演解译异常警告：</span>
                        </h4>
                        {% for warn in request.inference.warnings %}
                            <div class="p-3 bg-amber-50/40 border-l-3 border-amber-700 rounded text-xs text-slate-700 flex items-center gap-2 print-card print-border">
                                <span class="font-mono text-amber-800 font-bold">[WARN_OP]</span>
                                <span class="print-text">{{ warn }}</span>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>

        </section>
    {% endif %}

    <!-- ==========================================================================
       SECTION 5: 农事精细化控制建议 (新增：突出应用落地、大局观)
       ========================================================================== -->
    <section id="section-prescriptions" class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm print-card">
        <h2 class="text-sm font-bold text-slate-900 tracking-wide uppercase mb-4 flex items-center gap-2 pb-2 border-b border-slate-100 print-title">
            <svg class="w-4 h-4 text-emerald-950" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
            </svg>
            空间靶向精准农业农事处方 (Spatial VRA Prescriptions)
