                        {{ extra.prescriptions.p1 | default('该区域作物新陈代谢活跃，当前无需额外的微量元素干预。宜贯彻既定长效底肥控释策略，根据气象周期，在后期灌浆期执行常态微湿灌溉，防范水分饱和引起根系自呼吸受阻，力争巩固原有丰产根基。') }}
                    </p>
                </div>
                <div class="mt-4 pt-2 border-t border-slate-200 text-[10px] font-mono text-emerald-800">
                    ACTION: 控水晒田/常规肥水随灌
                </div>
            </div>

            <div class="p-4 bg-slate-50 border border-slate-200 rounded-lg flex flex-col justify-between print-card">
                <div>
                    <span class="px-2 py-0.5 bg-amber-100 text-amber-950 border border-amber-300 rounded text-[9px] font-bold uppercase tracking-wider block w-max mb-2">二类异常逆境区</span>
                    <h4 class="text-xs font-bold text-slate-800 mb-1.5">精准变量肥水调控 (VRA Fertilizer)</h4>
                    <p id="lbl-presc-2" class="text-[11px] text-slate-500 leading-relaxed text-justify">
                        {{ extra.prescriptions.p2 | default('由于光谱叶绿素反射波谷抬升，该带表现出明显的生理亚健康。须启动多旋翼无人植保机组对特定坐标地块进行变量追施速效尿素 6-8 公斤/亩，并在日落前灌溉浅水促根，打破养分输送物理瓶颈。') }}
                    </p>
                </div>
                <div class="mt-4 pt-2 border-t border-slate-200 text-[10px] font-mono text-amber-800">
                    ACTION: UAV靶向精准施肥/定向补灌
                </div>
            </div>

            <div class="p-4 bg-slate-50 border border-slate-200 rounded-lg flex flex-col justify-between print-card">
                <div>
                    <span class="px-2 py-0.5 bg-red-100 text-red-950 border border-red-300 rounded text-[9px] font-bold uppercase tracking-wider block w-max mb-2">三类重度病阻区</span>
                    <h4 class="text-xs font-bold text-slate-800 mb-1.5">植保病虫靶向阻断 (Pathogen Defense)</h4>
                    <p id="lbl-presc-3" class="text-[11px] text-slate-500 leading-relaxed text-justify">
                        {{ extra.prescriptions.p3 | default('对应反射区近红外陡落，水气吸收指数干枯。怀疑已遭受大面积侵染或物理性坏死，需要立刻调配高浓广谱高效药剂（如三环唑/吡唑醚菌酯）进行局部封闭式喷洒，杜绝大田级交叉感染损耗。') }}
                    </p>
                </div>
                <div class="mt-4 pt-2 border-t border-slate-200 text-[10px] font-mono text-red-800">
                    ACTION: 生理病损靶向喷药/隔离深翻
                </div>
            </div>
        </div>
    </section>

    <!-- ==========================================================================
       SECTION 6: 专家知识检索区 (条件: request.rag is not none)
       ========================================================================== -->
    {% if request.rag is not none %}
        <section id="section-rag" class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm hover:border-slate-300 transition duration-200 print-card">
            <h2 class="text-sm font-bold text-slate-900 tracking-wide uppercase mb-4 flex items-center gap-2 pb-2 border-b border-slate-100 print-title">
                <svg class="w-4 h-4 text-emerald-950" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                </svg>
                国家大田规范与专家知识支撑 (RAG)
            </h2>
            
            <div class="p-4 bg-slate-50 border border-slate-200 rounded-lg mb-4 print-card">
                <p id="lbl-rag-summary" class="font-serif text-[13px] leading-relaxed text-slate-700 text-justify indent-8 print-text">
                    {{ request.rag.summary | default('正在匹配地物先验知识。如果因无网络造成匹配缺失，建议参照大区级高标准农田作物栽培标准规程进行地块对标。') }}
                </p>
            </div>

            <div id="container-rag-sources" class="space-y-2">
                {% if request.rag.sources %}
                    <h4 class="text-[10px] font-mono text-slate-400 uppercase tracking-wider">规程及引用标准文献:</h4>
                    <ul id="wrapper-rag-sources" class="grid grid-cols-1 md:grid-cols-2 gap-2 text-xs text-slate-500 font-mono list-inside list-disc">
                        {% for src in request.rag.sources %}
                            <li class="truncate hover:text-slate-700 transition-colors print-text" title="{{ src }}">{{ src }}</li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
        </section>
    {% endif %}

    <!-- ==========================================================================
       SECTION 7: 综合链路置信度评价 (极简线段式仪表盘，去除刺眼发光)
       ========================================================================== -->
    {% if request.confidence is not none %}
        <section id="section-confidence" class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm print-card">
            <h2 class="text-sm font-bold text-slate-900 tracking-wide uppercase mb-6 flex items-center gap-2 pb-2 border-b border-slate-100 print-title">
                <svg class="w-4 h-4 text-emerald-950" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="M9 12l2 2 4-4"></path>
                </svg>
                反演计算质量保障评估 (Quality Assurance)
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
                <!-- 左侧：环形置信度仪表 (高档灰白线条形式) -->
                <div class="md:col-span-4 flex flex-col items-center justify-center">
                    {% set final_conf = request.confidence.final_confidence | default(0.0) %}
                    {% set final_label = request.confidence.final_label | default('medium') %}
                    {% set stroke_color = '#475569' %} 
                    {% if final_label == 'high' %}{% set stroke_color = '#0f5132' %}
                    {% elif final_label == 'low' %}{% set stroke_color = '#991b1b' %}
                    {% endif %}
                    
                    <div class="relative w-36 h-36 flex items-center justify-center">
                        <svg class="w-full h-full -rotate-90" viewBox="0 0 100 100">
                            <!-- 背景圆轨 -->
                            <circle cx="50" cy="50" r="40" fill="none" stroke="#f1f5f9" stroke-width="6" stroke-linecap="round" stroke-dasharray="188.4 251.2" class="print-track" />
                            <!-- 刻度前景 -->
                            <circle id="conf-gauge-arc" cx="50" cy="50" r="40" fill="none" stroke="{{ stroke_color }}" stroke-width="6" stroke-linecap="round"
                                    stroke-dasharray="188.4 251.2"
                                    stroke-dashoffset="{{ 188.4 * (1.0 - final_conf) }}" class="transition-all duration-1000 print-fill" />
                        </svg>
                        
                        <!-- 置信数值 -->
                        <div class="absolute inset-0 flex flex-col items-center justify-center text-center space-y-0.5">
                            <span id="lbl-gauge-percent" class="text-2xl font-extrabold tracking-tight font-mono" style="color: {{ stroke_color }};">
                                {{ (final_conf * 100) | round(0) }}<span class="text-xs font-semibold">%</span>
                            </span>
                            <span id="lbl-gauge-label" class="text-[9px] font-bold tracking-widest uppercase px-2 py-0.5 rounded border" style="color: {{ stroke_color }}; border-color: {{ stroke_color }}40; background-color: {{ stroke_color }}08;">
                                {{ final_label | upper }}
                            </span>
                        </div>
                    </div>
                </div>

                <!-- 右侧：四维分解指标条 (无霓虹蓝) -->
                <div class="md:col-span-8 space-y-4">
                    <!-- 维度1 -->
                    <div class="space-y-1">
                        <div class="flex justify-between text-xs font-semibold">
                            <span class="text-slate-500">1. 光学影像有效性及云阻偏差 (Image Validation)</span>
                            <span id="lbl-conf-image" class="font-mono text-slate-700 print-text">{{ (request.confidence.image_confidence | default(0.0) * 100) | round(1) }}%</span>
                        </div>
                        <div class="h-1.5 w-full bg-slate-100 border border-slate-200 rounded-full overflow-hidden print-track">
                            <div id="bar-conf-image" class="h-full bg-slate-500 rounded-full print-fill" style="width: {{ request.confidence.image_confidence | default(0.0) * 100 }}%"></div>
                        </div>
                    </div>

                    <!-- 维度2 -->
                    <div class="space-y-1">
                        <div class="flex justify-between text-xs font-semibold">
                            <span class="text-slate-500">2. 作物理论生长进程先验对齐 (Phytological Fit)</span>
                            <span id="lbl-conf-text" class="font-mono text-slate-700 print-text">{{ (request.confidence.text_confidence | default(0.0) * 100) | round(1) }}%</span>
                        </div>
                        <div class="h-1.5 w-full bg-slate-100 border border-slate-200 rounded-full overflow-hidden print-track">
                            <div id="bar-conf-text" class="h-full bg-slate-500 rounded-full print-fill" style="width: {{ request.confidence.text_confidence | default(0.0) * 100 }}%"></div>
                        </div>
                    </div>

                    <!-- 维度3 -->
                    <div class="space-y-1">
                        <div class="flex justify-between text-xs font-semibold">
                            <span class="text-slate-500">3. 气象雷达同化联合精度系数 (Radarsat Coherency)</span>
                            <span id="lbl-conf-workflow" class="font-mono text-slate-700 print-text">{{ (request.confidence.workflow_confidence | default(0.0) * 100) | round(1) }}%</span>
                        </div>
                        <div class="h-1.5 w-full bg-slate-100 border border-slate-200 rounded-full overflow-hidden print-track">
                            <div id="bar-conf-workflow" class="h-full bg-slate-500 rounded-full print-fill" style="width: {{ request.confidence.workflow_confidence | default(0.0) * 100 }}%"></div>
                        </div>
                    </div>

                    <!-- 联合评级 -->
                    <div class="space-y-1 pt-2 border-t border-slate-100">
                        <div class="flex justify-between text-xs font-bold">
                            <span class="text-slate-700">4. 融合决策信赖综合总分 (Total Operational Score)</span>
                            <span id="lbl-conf-final" class="font-mono text-emerald-950 print-text">{{ (final_conf * 100) | round(1) }}%</span>
                        </div>
                        <div class="h-2 w-full bg-slate-100 border border-slate-200 rounded-full overflow-hidden print-track">
                            <div id="bar-conf-final" class="h-full bg-emerald-950 rounded-full print-fill" style="width: {{ final_conf * 100 }}%"></div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- 评分释义文本 -->
            <div id="container-conf-explanation">
                {% if request.confidence.explanation %}
                    <div class="mt-6 p-4 bg-slate-50 border border-slate-200 rounded-lg text-xs leading-relaxed text-slate-500 print-card">
                        <p class="print-text">
                            <strong class="text-slate-700">工程评分逻辑：</strong> <span id="lbl-conf-explanation">{{ request.confidence.explanation }}</span>
                        </p>
                    </div>
                {% endif %}
            </div>

            <!-- 联合评估警报 -->
            <div id="container-conf-warnings">
                {% if request.confidence.warnings %}
                    <div class="mt-4 space-y-2">
                        {% for p_warn in request.confidence.warnings %}
                            <div class="p-3 bg-red-50/60 border-l-3 border-red-700 rounded text-xs text-slate-700 flex items-center gap-2 print-card print-border">
                                <span class="font-mono text-red-800 font-bold">[ENGINE_WARN]</span>
                                <span class="print-text">{{ p_warn }}</span>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>

        </section>
    {% endif %}

    <!-- ==========================================================================
       SECTION 8: 报告页脚与学术规范说明
       ========================================================================== -->
    <footer class="pt-6 border-t border-slate-200 flex flex-col md:flex-row md:justify-between md:items-start text-[10px] text-slate-400 gap-4">
        <div class="max-w-3xl leading-relaxed text-justify print-text">
            <strong>专业性免责说明：</strong>
            本技术报告所呈现的所有空间测定、干物质理论估计、灾损胁迫概率值，均为多源遥感传感器红边反射率、微波孔径雷达消融插值模型、及作物生长同化动力学算子（WOFOST/DSSAT）计算得到之空间宏观定量推演值，而非实地高精度全天候水准测绘级物理实测。由于大区地物反射可能受云盖校正残差、局地散射及大气气溶胶波动之扰动，数据可能存在约±5%的空间偏置，仅建议用作大田变量施肥及农业防灾之靶向参考，不作为民事法律责任索赔纠纷之绝对直接证据。
        </div>
        
        <div class="font-mono text-left md:text-right space-y-1 flex-shrink-0">
            <div>SPATIAL_ENGINE: <span class="text-slate-600 font-semibold">GeoAI Engine Core</span></div>
            <div>DATASOURCE: <span class="text-slate-600 font-semibold">Sentinel-2 MSI / Gaofen-6 / Sentinel-1 SAR</span></div>
            <div>VERIFICATION_HASH: <span class="text-slate-500">{{ report_id | default('N/A') }}</span></div>
        </div>
    </footer>

</div>

<!-- ==========================================================================
   SECTION 9: 遥感高级测绘仿真引擎与多端交互脚本 (预览时强制生效)
   ========================================================================== -->
<script>
{% raw %}
    // 学术配色体系：深度贯彻莫兰迪与中性配色
    const scenarios = {
        baldness_detection: {
            title: "河南省浚县小麦冬前斑秃退化与出苗断垄测绘遥感评估报告",
            request_id: "RS-2026-HN-WHEAT-BALD",
            user_query: "精细识别浚县小麦冬前退化断垄与出苗斑秃斑块，评估出苗质量并开具变量施肥处方。",
            region: "henan",
            crop_type: "wheat",
            task_type: "baldness_detection",
            overview: "本报告利用高分六号（GF-6）与哨兵-2号红边通道，对河南省浚县小麦核心示范田冬前分蘖期出苗状态实施空间反演。通过提取混合像元植被指数、排除土壤水分及耕作垄间背景干扰，圈定重度断垄与退化死苗多边形群落，用以科学制备冬施速效分蘖氮肥变量喷洒控制数据。",
            findings: [
                "小麦冬前断垄死苗重度斑秃面积计 1,245.8 亩，整体出苗斑秃比率占总种植面积的 9.97%。",
                "极重度连片断垄主要分布于黄河故道沙区，由于播种期局地失熵干旱，出苗健壮度偏弱。",
                "斑秃区反射NDVI大幅落后24%，且根系发育受抑，需于冬前撤水施肥，促进冬灌壮苗分蘖。"
            ],
            sensors: {
                opt: "Sentinel-2 MSI + GF-6 (10M)",
                sar: "Sentinel-1 C-SAR (VV/VH)",
                gdd: "+42.5 ℃·d (偏早发育)",
                sm: "21.2 % (适墒轻旱)"
            },
            model_name: "Spatial-GeoSegNet",
            model_version: "v3.2.1",
            affected_area: 1245.8,
            confidence: 0.91,
            positive_ratio: 0.0997,
            est_loss: "8.4 % (潜在减产)",
            polygons: 12,
            warnings: [
                "大区边缘存在道路建设阻隔引起的边界效应，局地约有2%像元出现虚警过饱。"
            ],
            rag_summary: "根据《河南省冬小麦冬前长势监测规范》（DB41/T 1982-2020），凡小麦分蘖中期出苗退化断垄比率超过8%的示范田，必须在冬前封冻（日均温降至5℃以下）前，使用高空植保机向异常斑块靶向追施速效氮肥（尿素 8-10kg/亩），保障越冬健壮度。",
            rag_sources: [
                "DB41/T 1982 《麦田冬前生长态势多源卫星监测规范》",
                "农业农村部《2026年黄淮海冬小麦冬前管理技术指导方案》"
            ],
            image_confidence: 0.94,
            text_confidence: 0.88,
            workflow_confidence: 0.92,
