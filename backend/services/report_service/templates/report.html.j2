        class_distribution: [
            { label: "常规发育正常长势 (Normal Crop)", value: 68000, ratio: 0.68, color: "#1b4332", is_target: false, bar_height_pct: 100 },
            { label: "分蘖偏旺过度发育 (Vigorous Crop)", value: 24000, ratio: 0.24, color: "#2d6a4f", is_target: false, bar_height_pct: 35 },
