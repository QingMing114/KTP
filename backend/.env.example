# KTP 后端配置模板
# 复制此文件为 .env 并修改配置

# === 应用配置 ===
APP_NAME=remote-sensing-multi-agent
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=18080
LOG_LEVEL=INFO

# === API 安全配置（生产环境必须启用）===
APP_AUTH_ENABLED=true
APP_AUTH_TOKEN=your-secure-token-here
APP_JWT_SECRET=your-jwt-secret-here

# === CORS 配置 ===
# 允许的来源域名，多个用逗号分隔
# 生产环境必须设置为实际域名，例如: https://app.example.com
# 留空则允许所有来源（不安全）
APP_CORS_ORIGINS=

# === 速率限制 ===
APP_RATE_LIMIT=60
APP_RATE_WINDOW=60

# === 请求限制 ===
APP_MAX_REQUEST_BODY_MB=10

# === LLM 配置 ===
AGENT_LLM_BACKEND=openai_compatible
AGENT_LLM_OPENAI_API_BASE=http://127.0.0.1:8000/v1
AGENT_LLM_OPENAI_API_KEY=EMPTY
AGENT_LLM_OPENAI_MODEL_NAME=Qwen/Qwen3.5-27B
AGENT_LLM_OPENAI_DISABLE_THINKING=true
AGENT_LLM_REQUEST_TIMEOUT_SECONDS=180

# === 数据库 ===
DATABASE_URL=sqlite:///./var/data/ktp_model_registry.db

# === Sentinel-2 影像 ===
SENTINEL_STAC_SEARCH_URL=https://planetarycomputer.microsoft.com/api/stac/v1/search
SENTINEL_STAC_ASSET_TOKEN_URL=https://planetarycomputer.microsoft.com/api/sas/v1/token
SENTINEL_STAC_TIMEOUT_SECONDS=30
SENTINEL_COG_CONNECT_TIMEOUT_SECONDS=15
SENTINEL_COG_READ_TIMEOUT_SECONDS=120
SENTINEL_COG_MAX_RETRIES=2
SENTINEL_COG_RETRY_DELAY_SECONDS=1

# === LAI 反演与报告 ===
# 留空时报告统一写入 ktp/reports，并由 /v2/reports 与 canonical artifact URL 提供访问
LAI_REPORT_OUTPUT_DIR=
LAI_REPORT_TEMPLATE_PATH=
# 每个批次完成后推送一次真实像元进度；较小值更新更频繁、矩阵调用次数更多
LAI_INVERSION_BATCH=512

# === V2 运行时 ===
V2_API_STORE_BACKEND=sqlite
V2_API_SQLITE_PATH=./var/data/ktp_v2_runtime.sqlite3
# Optional read-only Markdown knowledge retrieval.  The directory must contain
# a MEMORY.md index that links to the documents available to the Agent.
V2_API_MEMORY_DIR=
V2_API_MEMORY_TOP_K=5
V2_API_MEMORY_MAX_CHARS=2000
V2_API_MEMORY_AUTO_WRITE_ENABLED=false

# === 斑秃识别模型 ===
BALDNESS_RF_DEFAULT_MODEL_PATH=
BALDNESS_RF_WORK_DIR=./var/runtime/baldness_rf

# === 推理配置 ===
ORCHESTRATOR_DEFAULT_USE_MOCK=false
